{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/cantinero-front",
  "redirects": [
    { "source": "/", "destination": "/cantinero/", "permanent": false },
    { "source": "/cantinero", "destination": "/cantinero/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "https://cantinero-api.onrender.com/api/v1/$1" },
    { "source": "/uploads/(.*)", "destination": "https://cantinero-api.onrender.com/uploads/$1" },
    { "source": "/cantinero/(.*)", "destination": "/cantinero/index.html" }
  ]
}
